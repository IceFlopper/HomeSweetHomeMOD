<Defs>

  <!--
    Vanilla Traits Expanded, plus a couple of traits from other popular mods.
    None of these are hard references. If the mod isn't installed the profile is
    dropped on load and nothing is logged, so this file is safe to ship as is.
  -->

  <!--===================== people who like being gone =====================-->

  <!-- VTE already makes these two walk faster in a caravan. Being cooped up at home is the problem. -->
  <HomeSweetHome.TraitProfileDef>
    <defName>HSH_Trait_VTE_Wanderlust</defName>
    <trait>VTE_Wanderlust</trait>
    <missing>0.8</missing>
    <homesick>0.25</homesick>
    <company>1.1</company>
  </HomeSweetHome.TraitProfileDef>

